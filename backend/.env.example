# SETU backend — environment variables
#
# Copy this file to .env for local overrides if your tooling loads it
# (the app itself uses os.environ directly; python-dotenv is not a
# dependency, so a .env file is not auto-loaded by uvicorn — export these
# variables in your shell or your process manager instead).

# Comma-separated list of origins allowed to call this API via CORS.
# Local development default (used automatically if this variable is unset):
CORS_ORIGINS=http://localhost:5173

# Production example (set this in the Render dashboard once the frontend's
# deployed URL is known — do not commit the real value):
# CORS_ORIGINS=https://setu-sih-2026-1.onrender.com
