# SETU frontend — environment variables
#
# Copy this file to .env.local for local overrides. Vite only reads
# variables prefixed with VITE_, and they are baked into the build at
# build time (not read at runtime).

# Base path/URL the frontend calls for the API. Defaults to the relative
# path "/api" if this variable is unset (works with the local Vite dev
# proxy, see vite.config.js).
VITE_API_BASE_URL=/api

# Production example (set this in the Render Static Site's environment
# variables, then trigger a rebuild — do not commit the real value):
# VITE_API_BASE_URL=https://setu-api-lzx9.onrender.com/api
